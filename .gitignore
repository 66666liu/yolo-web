../.idea/
node_modules/

# 运行时生成的IP记录
ip_operations.json
operation_log.json

# 点赞与抽卡次数（按 IP 的运行时状态）
likes.json
gacha_tickets.json

# 站点配置：config.js 里可能放 ADMIN_KEY_HASH，不入库；模板 config.example.js 入库
config.js

# npm 本地缓存（沙箱/CI 用，不入库）
.npm-cache/

# 夜鹭检测模型与运行时缓存
models/*.onnx
recognition_cache.json
recognition_cache.json.tmp

# 图片查重指纹缓存（删掉会重新计算）
dedup_cache.json
dedup_cache.json.tmp

# 全站长图（抽卡终极大奖的产物，服务端后台生成；删掉会自动重算）
long-image/

# Live2D 看板娘模型：来自第三方（版权不明，不宜入库），按"自行放入"处理，
# 和上面的 models/*.onnx 一个路子。部署时 scp 过去（见《部署方案-国内轻量.md》可选那节）。
# 缺失时服务照常运行：看板娘不显示，其余功能不受影响。
# 注意框架本身（public/live2d-vendor/，152KB）是入库的，别写进这里。
public/live2d/

# Live2D 源模型目录（只留 default.v2 一套，其余 15 套服装已删；用到的已复制到 public/live2d/）
live 2d/
